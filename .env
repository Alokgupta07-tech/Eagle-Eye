# SENTINEL configuration — copy to .env and edit. Every value has a safe default.

# Storage: sqlite:///path  OR  postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/sentinel.db
REDIS_URL=redis://localhost:6379/0

# Embedding service: auto | st | offline   (auto tries sentence-transformers, falls back offline)
EMBEDDER=auto

# Multi-model jury — provider/model triples; a provider without a key is replaced by MockJudge
JURY_MODELS=anthropic/claude-sonnet-4-20250514,openai/gpt-4o,google/gemini-2.0-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Detection tuning
SESSION_WINDOW=20
SESSION_TTL_S=1800
SIMILARITY_STRONG=0.85
BAND_REVIEW_LO=30
BAND_BLOCK_HI=70
CONF_MIN_BLOCK=0.4
FUSION_W=rules:0.35,similarity:0.30,obfuscation:0.10,judge:0.25
OBFUSCATION_BONUS=15
DRIFT_K=2.5
BASELINE_PROBES=50
RULE_REFRESH_S=300

# Mock target vulnerability knobs (the demo canary/vulnerable target)
VULN_EXTRACTION=true
VULN_ROLEPLAY=true
VULN_DELIMITER=true
VULN_LEAK_KEYS=true
VULN_DECODE=true
MOCK_CANARY=CANARY-9F2A41C8
MOCK_API_KEY=SK-DEMO-9F27KQZ41LX8M3H7T2V5B6N1

# Control-plane key — pinned for the demo bundle so you can unlock the console
# (also printed at every server boot). Override in production.
SENTINEL_ADMIN_KEY=sentinel-admin-demo-key
